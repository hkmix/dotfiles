configuration {
    font: "${jz_font_semibold} ${jz_font_size_medium}";
    disable-history: true;
    matching: "regex";
    scroll-method: 0;

    timeout {
        action: "kb-cancel";
        delay: 0;
    }

    filebrowser {
        directories-first: true;
        sorting-method: "name";
    }
}

@theme "solarized"
